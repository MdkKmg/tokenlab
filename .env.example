# Copier en .env pour un lancement local (uvicorn app.main:app --reload)

KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=realm-1
KEYCLOAK_CLIENT_ID=tokenlab
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPE=openid profile email
ENABLE_PKCE=true
ENABLE_DPOP=true
# Affiche les sections "Echanges HTTP", "Comprendre PKCE", "Comprendre DPoP" et les
# panneaux de valeurs PKCE/DPoP de la tentative dans l'UI.
ENABLE_EXPLANATIONS=true
# Affiche le bloc "Bonnes pratiques minimales" (accueil) et leurs controles sur les
# tokens obtenus (page de resultat).
ENABLE_RECOMMANDATIONS=true
# Affiche le bouton "Copier l'access_token" sur la page de resultat. A false, les
# tokens sont aussi masques dans les sections "Tokens bruts" et "Echanges HTTP".
COPY_BUTTON=false
# Optionnel : pre-remplit le champ ACR de l'UI (modifiable a chaque login sans redeployer).
ACR_VALUES=
ACR_ESSENTIAL=false

PUBLIC_BASE_URL=http://localhost:8080
# REDIRECT_URI=  # optionnel, sinon derive de PUBLIC_BASE_URL + /callback

PORT=8080
LOG_LEVEL=INFO
STATE_TTL_SECONDS=300
# HTTP_VERIFY_TLS n'est plus configurable ici : fige au build de l'image (voir Dockerfile).
